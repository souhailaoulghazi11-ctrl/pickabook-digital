# ---------------------------------------------------------------------------
# PickaBook — environment variables
# Copy this file to ".env.local" and fill in your real Shopify credentials.
# Nothing in this app will hit Shopify until these are set — until then,
# every API route falls back to the local mock catalog in lib/products.js.
# ---------------------------------------------------------------------------

# Storefront API (public-facing reads: products, collections, cart)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# Admin API (server-only: orders, fulfillments, webhook registration)
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signature verification (Settings > Notifications > Webhooks in Shopify admin)
SHOPIFY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret used to sign secure, time-limited digital-download links
DOWNLOAD_LINK_SECRET=replace-with-a-long-random-string
